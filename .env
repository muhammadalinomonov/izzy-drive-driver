# Mapbox PUBLIC access token (pk.*) — used at runtime by
# MapboxOptions.setAccessToken() in lib/src/core/service_locater.dart.
# Must be a public token. Never put an sk.* secret token here: .env ships
# inside the app bundle, so a secret token is extractable by anyone.
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiYXphbW92IiwiYSI6ImNtY2hzbjFibjB3cHMycm45N2lkaTZnMWQifQ.6stCvz6FLKcLLhiUEW2NFQ
# TODO(driver-creds): paste the driver app's OAuth 2.0 Web client id from Google Cloud Console (the backend audience)
GOOGLE_WEB_CLIENT_ID=990409386975-gplpte34uls11dupf72coocs415oobmh.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Quadrix Tolling (https://toll-api.quadrix.ai/api/v1/) — SEPARATE backend
# from api.izzydrive.com, with its own Laravel Sanctum token.
#
# TEMPORARY. This is a shared test token for driver@gmail.com ("Abu LLC"),
# pasted so the Trips tab can talk to a live backend before the app has a
# Quadrix sign-in screen. Replace it with a per-user token obtained from
# POST mobile/auth/login (persist via TollSession.saveToken) and delete this
# line — .env is COMMITTED to this repo and ships inside the app bundle, so
# anything here is readable by anyone with the apk/ipa.
#
# X-Organization-Id is deliberately NOT set here: TollSession resolves it
# from GET auth/me on first request and caches it. Set QUADRIX_ORG_ID only to
# override that lookup.
QUADRIX_TOLL_TOKEN=16|VyKhMKzXCNKsO5SEwx5o6dhAgHNtfhjaNgpXRzNaf156a06c

# Reverb (Pusher-protocol) WebSocket for the support-chat / route-review push
# channel (docs/support-chat-api.md §1). Both values come from the backend
# team, not from this app — TollReverbService no-ops (skips connect, no
# retry storm) while either is empty, so the app keeps working off the
# existing REST polling until these are filled in.
# TODO(reverb-creds): ask backend for the Reverb host and app key.
QUADRIX_REVERB_HOST=
QUADRIX_REVERB_APP_KEY=

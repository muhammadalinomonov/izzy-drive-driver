	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.990409386975-0b8f6acpmuv91elajd7n19rqq0tbsov4</string>
			</array>
		</dict>
